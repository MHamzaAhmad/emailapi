# Environment Variables

# Server
PORT=8080
GRPC_PORT=9090
ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://emailapi:emailapi@localhost:5432/emailapi?sslmode=disable

# ClickHouse
CLICKHOUSE_URL=localhost:9000

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-email-attachments-bucket

# Internal Webhook Authentication (for EventBridge GuardDuty callbacks)
INTERNAL_WEBHOOK_SECRET=your-secure-random-secret-here

