# Environment Variables

# Server
PORT=8080
GRPC_PORT=9090
ENV=development

# Database (PostgreSQL)
# DATABASE_URL is for pooled connections (via PgBouncer for Neon)
DATABASE_URL=postgres://emailapi:emailapi@localhost:5432/emailapi?sslmode=disable
# DATABASE_URL_DIRECT is for direct connections (required by River for LISTEN/NOTIFY and for migrations)
# For Neon: use the connection string WITHOUT "-pooler" in the hostname
DATABASE_URL_DIRECT=postgres://emailapi:emailapi@localhost:5432/emailapi?sslmode=disable

# ClickHouse
CLICKHOUSE_URL=localhost:9000

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-email-attachments-bucket

# Internal Webhook Authentication (for EventBridge GuardDuty callbacks)
INTERNAL_WEBHOOK_SECRET=your-secure-random-secret-here

# ClickHouse
CLICKHOUSE_HOST=localhost:9000
CLICKHOUSE_DATABASE=emailapi
CLICKHOUSE_USERNAME=emailapi
CLICKHOUSE_PASSWORD=emailapi

# Svix (webhook delivery to users)
SVIX_API_KEY=your-svix-api-key

# S3 Inbound Bucket (SES stores inbound/reply emails here)
S3_INBOUND_BUCKET=your-ses-inbound-bucket
