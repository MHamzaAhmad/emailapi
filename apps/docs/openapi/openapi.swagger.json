    "/v1/emails": {
      "get": {
        "summary": "ListEmails retrieves a paginated list of emails sent by the authenticated user.",
        "description": "Results are ordered by creation time descending.",
        "operationId": "EmailService_ListEmails",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListEmailsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "category",
            "description": "Category to query: ACTIVE (in-progress) or ARCHIVED (completed).\nDefault: ACTIVE\n\n - EMAIL_CATEGORY_ACTIVE: Active emails in PostgreSQL (pending, processing, scanning, queued).\n - EMAIL_CATEGORY_ARCHIVED: Archived emails in ClickHouse (sent, delivered, bounced, failed).",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "EMAIL_CATEGORY_UNSPECIFIED",
              "EMAIL_CATEGORY_ACTIVE",
              "EMAIL_CATEGORY_ARCHIVED"
            ],
            "default": "EMAIL_CATEGORY_UNSPECIFIED"
          },
          {
            "name": "limit",
            "description": "Maximum number of emails to return (default: 20, max: 100).",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "description": "Number of emails to skip.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "EmailService"
        ]
      }
    },
