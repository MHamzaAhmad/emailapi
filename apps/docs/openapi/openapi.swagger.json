  "definitions": {
    "DomainServiceSetMailFromDomainBody": {
      "type": "object",
      "properties": {
        "mailFromSubdomain": {
          "type": "string",
          "description": "Subdomain to use for MAIL FROM (e.g., \"mail\" for mail.example.com).\nMust be a subdomain of the verified domain."
        }
      },
      "description": "SetMailFromDomainRequest configures a custom MAIL FROM domain."
    },
    "WebhookServiceUpdateWebhookBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
