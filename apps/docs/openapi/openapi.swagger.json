            }
          }
        },
        "tags": [
          "DomainService"
        ]
      },
      "post": {
        "summary": "AddDomain registers a new sending domain with AWS SES.",
        "description": "After adding, use GetDomainRecords to retrieve DNS records you need to\nconfigure. The domain starts in PENDING status until DNS is verified.",
