    "v1DnsRecord": {
      "type": "object",
      "properties": {
        "dnsType": {
          "type": "string",
          "description": "Type of DNS record (e.g., CNAME, TXT, MX)."
        },
        "name": {
          "type": "string",
          "description": "Record name/host (e.g., \"selector1._domainkey.example.com\")."
        },
        "value": {
          "type": "string",
          "description": "Record value to set."
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "Priority for MX records. Ignored for other record types."
        },
        "recordType": {
          "$ref": "#/definitions/v1RecordType",
          "description": "Purpose of this record."
        },
        "status": {
          "$ref": "#/definitions/v1RecordStatus",
          "description": "Current verification status of this record."
        },
        "instructions": {
          "type": "string",
          "description": "Human-readable instructions for configuring this record."
        }
      },
      "description": "DnsRecord represents a single DNS record that needs to be configured."
    },
    "v1Domain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the domain."
        },
        "domain": {
          "type": "string",
          "description": "The domain name (e.g., \"example.com\")."
        },
        "status": {
          "$ref": "#/definitions/v1DomainStatus",
          "description": "Current verification status."
        },
        "verifiedForSending": {
          "type": "boolean",
          "description": "Whether the domain is verified and ready to send emails."
        },
        "mailFromDomain": {
          "type": "string",
          "description": "Custom MAIL FROM subdomain (e.g., \"mail.example.com\").\nEmpty if not configured."
        },
        "mailFromStatus": {
          "$ref": "#/definitions/v1DomainStatus",
          "description": "MAIL FROM configuration status."
        },
        "region": {
          "type": "string",
          "description": "Region where the domain is registered in SES."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time when the domain was added."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time when the domain was last updated."
        }
      },
      "description": "Domain represents a verified sending domain."
    },
    "v1DomainRecords": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "The domain these records belong to."
        },
        "dkimRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DnsRecord"
          },
          "description": "DKIM records (3 CNAME records for email signing)."
        },
        "spfRecord": {
          "$ref": "#/definitions/v1DnsRecord",
          "description": "SPF record (TXT record authorizing SES)."
        },
        "dmarcRecord": {
          "$ref": "#/definitions/v1DnsRecord",
          "description": "DMARC record (TXT record for authentication policy)."
        },
        "mxRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DnsRecord"
          },
          "description": "MX records for inbound email."
        },
        "mailFromRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DnsRecord"
          },
          "description": "MAIL FROM records (MX + SPF for custom return path).\nEmpty if MAIL FROM is not configured."
        },
        "isReadyToSend": {
          "type": "boolean",
          "description": "True when DKIM is verified and domain can send emails."
        },
        "isReadyToReceive": {
          "type": "boolean",
          "description": "True when MX records are configured for receiving emails."
        },
        "isFullyConfigured": {
          "type": "boolean",
          "description": "True when all records are verified (DKIM, SPF, DMARC, MAIL FROM)."
        }
      },
      "description": "DomainRecords contains all DNS records needed for email deliverability."
    },
    "v1DomainStatus": {
      "type": "string",
      "enum": [
        "DOMAIN_STATUS_UNSPECIFIED",
        "DOMAIN_STATUS_PENDING",
        "DOMAIN_STATUS_SUCCESS",
        "DOMAIN_STATUS_FAILED",
        "DOMAIN_STATUS_TEMPORARY_FAILURE"
      ],
      "default": "DOMAIN_STATUS_UNSPECIFIED",
      "description": "DomainStatus represents the verification status of a domain.\n\n - DOMAIN_STATUS_UNSPECIFIED: Default value, should not be used.\n - DOMAIN_STATUS_PENDING: Domain is pending verification. Configure DNS records and call VerifyDomain.\n - DOMAIN_STATUS_SUCCESS: Domain has been successfully verified and is ready for sending.\n - DOMAIN_STATUS_FAILED: Domain verification failed. Check DNS configuration and try again.\n - DOMAIN_STATUS_TEMPORARY_FAILURE: Temporary verification failure. Will be retried automatically."
    },
    "v1Email": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the email."
        },
        "from": {
          "type": "string",
          "description": "Sender email address."
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Primary recipients."
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CC recipients."
        },
