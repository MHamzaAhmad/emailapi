    "/v1/domains/{id}/mail-from": {
      "post": {
        "summary": "SetMailFromDomain configures a custom MAIL FROM subdomain.",
        "description": "This improves email deliverability by letting you control the Return-Path\nheader used for bounce handling. The subdomain must be part of your\nverified domain.\n\nExample: If your domain is \"example.com\", set mail_from to \"mail.example.com\"",
        "operationId": "DomainService_SetMailFromDomain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Domain"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "description": "ID of the domain to configure.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DomainServiceSetMailFromDomainBody"
            }
          }
        ],
        "tags": [
          "DomainService"
        ]
      }
    },
    "/v1/domains/{id}/records": {
      "get": {
        "summary": "GetDomainRecords returns all DNS records needed for full email deliverability.",
        "description": "This includes:\n  - DKIM records (3 CNAMEs) - Required for email signing/authentication\n  - SPF record (TXT) - Authorizes SES to send on your behalf\n  - DMARC record (TXT) - Policy for handling authentication failures\n  - MX record - Required for receiving inbound emails\n  - MAIL FROM records (MX + TXT) - Improves deliverability and bounce handling\n\nEach record includes its current verification status and instructions.",
        "operationId": "DomainService_GetDomainRecords",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DomainRecords"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "description": "ID of the domain.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DomainService"
        ]
      }
    },
    "/v1/domains/{id}/verify": {
      "post": {
        "summary": "VerifyDomain refreshes verification status from AWS SES.",
        "description": "Call this after configuring your DNS records to check if they have\npropagated and been verified by AWS. DNS propagation can take up to 72 hours.",
