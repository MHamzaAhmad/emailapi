{
    "name": "simpleemailapi",
    "version": "0.2.0",
    "description": "Email API SDK - Backend-first HTTP/2 gRPC client for Node.js and Bun",
    "license": "MIT",
    "author": "Simple Email API",
    "homepage": "https://simpleemailapi.dev",
    "keywords": [
        "email",
        "email-api",
        "grpc",
        "connect-rpc",
        "typescript",
        "sdk",
        "transactional-email",
        "nodejs"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "docs": "typedoc"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@bufbuild/protobuf": "^2.0.0",
        "@connectrpc/connect": "^2.0.0",
        "@connectrpc/connect-node": "^2.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "tsup": "^8.0.0",
        "typedoc": "^0.28.15",
        "typedoc-plugin-markdown": "^4.9.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}