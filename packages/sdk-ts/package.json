{
    "name": "emailapi-sdk",
    "version": "0.1.0",
    "description": "Email API SDK - Backend-first HTTP/2 gRPC client for Node.js and Bun",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "generate": "buf generate buf.build/emailapi/public --template buf.gen.yaml",
        "docs": "typedoc"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@bufbuild/protobuf": "^2.0.0",
        "@connectrpc/connect": "^2.0.0",
        "@connectrpc/connect-node": "^2.0.0"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typedoc": "^0.28.15",
        "typedoc-plugin-markdown": "^4.9.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}