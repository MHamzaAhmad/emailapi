# Performance Testing Configuration
# Copy to .env and fill in your values

# =============================================================================
# REQUIRED: API Authentication
# =============================================================================
PERF_API_KEY=your-api-key-here

# =============================================================================
# REQUIRED: Email Addresses
# =============================================================================
# From address must be on a verified domain
PERF_FROM_EMAIL=test@yourverified.domain

# To address - use a sink/test address that discards mail
PERF_TO_EMAIL=loadtest-sink@example.com

# =============================================================================
# OPTIONAL: API Endpoints (defaults are for production)
# =============================================================================
PERF_API_HOST=api.simpleemailapi.dev
PERF_GRPC_PORT=443
PERF_HTTP_PORT=443

# For local testing:
# PERF_API_HOST=localhost
# PERF_GRPC_PORT=9090
# PERF_HTTP_PORT=8080

# =============================================================================
# OPTIONAL: Test Parameters
# =============================================================================
# You can override these per-test, but these are sensible defaults
PERF_SMOKE_RPS=10
PERF_SMOKE_DURATION=30s

PERF_LOAD_RPS=100
PERF_LOAD_DURATION=2m

PERF_STRESS_START_RPS=50
PERF_STRESS_END_RPS=500
PERF_STRESS_DURATION=5m
