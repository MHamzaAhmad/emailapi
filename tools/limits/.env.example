# API Configuration
API_HOST=localhost:8080

# API Key (get from your account)
# Generate at: https://simpleemailapi.dev/dashboard/api-keys
API_KEY=sea_live_your_api_key_here

# Verified sender email (must be verified in SES)
# For production: use your domain email
# For testing: any verified email works
FROM_EMAIL=test@yourdomain.com

# =============================================================================
# AWS SES Simulator Addresses (MANDATORY - Do Not Change)
# =============================================================================
# These are special AWS addresses that trigger specific behaviors WITHOUT:
#   - Affecting your sending quota
#   - Impacting your reputation score (when used with dry-run)
#   - Sending actual emails to real recipients
#
# AWS Documentation:
# https://docs.aws.amazon.com/ses/latest/dg/send-an-email-from-console.html#send-email-simulator
# =============================================================================

SUCCESS_EMAIL=success@simulator.amazonses.com
BOUNCE_EMAIL=bounce@simulator.amazonses.com
COMPLAINT_EMAIL=complaint@simulator.amazonses.com

# =============================================================================
# Test Configuration
# =============================================================================

# SES Rate Limit Protection (requests per second)
# Prevents throttling by SES - adjust based on your SES sending quota
# Default: 1 req/s (safe for all accounts)
# Sandbox accounts: 1 req/s recommended
# Production accounts: Can increase to 5-10 depending on quota
SES_RATE_LIMIT=1

# Optional: Your user ID (for debugging/reset commands shown in test output)
TEST_USER_ID=user_xxx
