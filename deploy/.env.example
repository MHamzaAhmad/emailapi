# Server Configuration
PORT=8080
GRPC_PORT=9090
ENV=production

# Database (PostgreSQL)
# Must point to your external Postgres instance (e.g. Cloud SQL)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DATABASE=emailapi
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=localhost:9000

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1000

# AWS Configuration (SES & S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET=your-attachments-bucket
S3_INBOUND_BUCKET=your-inbound-bucket
SES_CONFIGURATION_SET=your-config-set

# Secrets
CLERK_SECRET_KEY=sk_...
CLERK_WEBHOOK_SECRET=whsec_...
INTERNAL_WEBHOOK_SECRET=your-internal-secret
API_KEY_HMAC_SECRET=your-hmac-secret
SVIX_API_KEY=test_...

# Web Risk
WEB_RISK_PROJECT_ID=your-gcp-project-id
WEB_RISK_API_KEY=your-api-key
