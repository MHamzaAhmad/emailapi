{
    "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "sharedGlobals": [],
        "openapi": [
            "{workspaceRoot}/packages/shared-spec/openapi.yaml"
        ]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "^build",
                "generate"
            ],
            "inputs": [
                "default",
                "^default"
            ],
            "cache": true
        },
        "generate": {
            "cache": true,
            "inputs": [
                "openapi"
            ],
            "dependsOn": []
        },
        "test": {
            "inputs": [
                "default",
                "^default"
            ],
            "cache": true
        },
        "lint": {
            "inputs": [
                "default",
                "^default"
            ],
            "cache": true
        }
    }
}