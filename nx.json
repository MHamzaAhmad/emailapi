{
    "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "sharedGlobals": []
    },
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "default",
                "^default"
            ],
            "cache": true
        },
        "test": {
            "inputs": [
                "default",
                "^default"
            ],
            "cache": true
        },
        "lint": {
            "inputs": [
                "default",
                "^default"
            ],
            "cache": true
        }
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.json"
                }
            }
        }
    ]
}